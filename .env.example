# Copy to .env to override defaults (docker compose reads .env automatically). No secrets: everything is local.
# Ollama runs on your Mac, not in Docker. From a container it is reached via host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
# qwen2.5:7b needs ~5 GB of RAM. On an 8 GB Mac, `ollama pull qwen2.5:3b` and set this to qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
# project2-payment-ledger's API (start it first: docker compose up -d in that folder).
LEDGER_URL=http://host.docker.internal:8001
# 1 = use the scripted fake LLM + fake embeddings (what CI does). 0 = real Ollama.
COPILOT_FAKE_LLM=0
